{
  "expo": {
    "name": "ScanIA",
    "slug": "scania",
    "scheme": "scania",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O ScanIA usa a câmera para fotografar suas notas fiscais.",
          "photosPermission": "O ScanIA acessa suas fotos para ler notas fiscais salvas na galeria.",
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.edu.iesb.scania"
    },
    "android": {
      "package": "br.edu.iesb.scania",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    }
  }
}
